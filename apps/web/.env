# === Local Development Environment Configuration ===
# Generated by: docker-compose.yml (PostgreSQL 17 + Redis 7.4)
# Database: runs in Docker container (luxeverse-postgres)
# Cache: runs in Docker container (luxeverse-redis)
# Access: Prisma ORM (apps/web)

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://luxeverse_user:luxeverse_dev_password@localhost:5432/luxeverse_db?schema=public"

# ---------------------------------------------------------------------------
# NEXTAUTH (v4 API)
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET="dev-secret-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="dev-secret-change-in-production"

# ---------------------------------------------------------------------------
# STRIPE
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ---------------------------------------------------------------------------
# REDIS (Cache, Sessions, Rate Limiting)
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
