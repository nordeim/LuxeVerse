apps/web/.next/dev/static/chunks/_08phq2v._.js.map:14:    {"offset": {"line": 365, "column": 0}, "map": {"version":3,"sources":["file:///home/project/LuxeVerse/apps/web/src/components/editorial/ProductEmbed.tsx"],"sourcesContent":["\"use client\";\n\nimport { useState } from \"react\";\nimport { Button } from \"@luxeverse/ui\";\nimport Image from \"next/image\";\n\nexport interface ProductEmbedProps {\n  product: {\n    productId: string;\n    name: string;\n    price: number;\n    image: string;\n  };\n}\n\nexport function ProductEmbed({ product }: ProductEmbedProps) {\n  const [isAdded, setIsAdded] = useState(false);\n\n  const handleQuickAdd = (): void => {\n    // TODO: Wire to cart mutation: await trpc.cart.addItem.mutate({ productId: product.productId, quantity: 1 });\n    setIsAdded(true);\n    setTimeout(() => setIsAdded(false), 2000);\n  };\n\n  return (\n    <div className=\"flex items-center gap-4\">\n      <div className=\"relative h-20 w-16 flex-shrink-0 overflow-hidden rounded-md bg-obsidian-100\">\n        <Image src={product.image} alt={product.name} width={64} height={80} className=\"h-full w-full object-cover\" />\n      </div>\n      <div className=\"flex flex-1 flex-col gap-1\">\n        <span className=\"text-sm font-medium text-obsidian-900\">{product.name}</span>\n        <span className=\"text-sm text-obsidian-600\">${product.price}</span>\n      </div>\n      <Button\n        variant=\"luxury\"\n        size=\"sm\"\n        onClick={handleQuickAdd}\n        disabled={isAdded}\n        className=\"whitespace-nowrap\"\n      >\n        {isAdded ? \"Added\" : \"Quick Add\"}\n      </Button>\n    </div>\n  );\n}\n"],"names":["ProductEmbed","product","isAdded","setIsAdded","handleQuickAdd","setTimeout","className","src","image","alt","name","width","height","price","variant","size","onClick","disabled"],"mappings":";;;;;AAEA;AACA;AAAA;AACA;;;AAJA;;;;AAeO,SAASA,aAAa,EAAEC,OAAO,EAAqB;;IACzD,MAAM,CAACC,SAASC,WAAW,GAAG,IAAA,0UAAQ,EAAC;IAEvC,MAAMC,iBA