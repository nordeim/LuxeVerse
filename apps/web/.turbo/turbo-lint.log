oup-hover:scale-105\"\n                />\n                <div className=\"absolute inset-0 bg-gradient-to-t from-obsidian-950/60 to-transparent\" />\n              </div>\n              <div className=\"absolute bottom-0 left-0 right-0 p-6 text-white\">\n                <h3 className=\"text-xl font-display font-medium\">{col.name}</h3>\n                <p className=\"mt-1 text-sm text-obsidian-100/80\">{col.count} Pieces</p>\n              </div>\n            </Link>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n}\n"],"names":["collections","id","name","slug","image","count","FeaturedCollections","className","map","col","idx","href","src","alt","width","height"],"mappings":";;;;;AAAA;AACA;AACA;AAAA;;;;;AAEA,sEAAsE;AACtE,MAAMA,cAAc;IAClB;QAAEC,IAAI;QAAKC,MAAM;QAAoBC,MAAM;QAAoBC,OAAO;QAAsBC,OAAO;IAAG;IACtG;QAAEJ,IAAI;QAAKC,MAAM;QAAgBC,MAAM;QAAgBC,OAAO;QAAsBC,OAAO;IAAG;IAC9F;QAAEJ,IAAI;QAAKC,MAAM;QAAiBC,MAAM;QAAiBC,OAAO;QAAsBC,OAAO;IAAG;CACjG;AAEM,SAASC;IACd,qBACE,+YAAC;QAAQC,WAAU;QAA4C,mBAAgB;kBAC7E,cAAA,+YAAC;YAAIA,WAAU;;8BACb,+YAAC;oBAAGN,IAAG;oBAA+BM,WAAU;8BAAoF;;;;;;8BAGpI,+YAAC;oBAAIA,WAAU;8BACZP,YAAYQ,GAAG,CAAC,CAACC,KAAKC,oBACrB,+YAAC,2VAAI;4BAEHC,MAAM,CAAC,aAAa,EAAEF,IAAIN,IAAI,EAAE;4BAChCI,WAAW,IAAA,oIAAE,EACX,2EACAG,QAAQ,IAAI,uBAAuB,GAAG,8BAA8B;;;8CAGtE,+YAAC;oCAAIH,WAAU;;sDACb,+YAAC,ySAAK;4CACJK,KAAKH,IAAIL,KAAK;4CACdS,KAAKJ,IAAIP,IAAI;4CACbY,OAAO;4CACPC,QAAQ;4CACRR,WAAU;;;;;;sDAEZ,+YAAC;4CAAIA,WAAU;;;;;;;;;;;;8CAEjB,+YAAC;oCAAIA,WAAU;;sDACb,+YAAC;4CAAGA,WAAU;sDAAoCE,IAAIP,IAAI;;;;;;sDAC1D,+YAAC;4CAAEK,WAAU;;gDAAqCE,IAAIJ,KAAK;gDAAC;;;;;;;;;;;;;;2BAnBzDI,IAAIR,EAAE;;;;;;;;;;;;;;;;;;;;;AA2BzB"}},
