apps/web/.next/dev/static/chunks/_05z0.-g._.js.map:8:    {"offset": {"line": 135, "column": 0}, "map": {"version":3,"sources":["file:///home/project/LuxeVerse/apps/web/src/components/sections/HeroSection.tsx"],"sourcesContent":["\"use client\";\n\nimport { useEffect, useRef } from \"react\";\nimport { motion, useScroll, useTransform, useReducedMotion } from \"framer-motion\";\nimport { MagneticButton } from \"@/components/shared/MagneticButton\";\n\nexport function HeroSection() {\n  const prefersReducedMotion = useReducedMotion();\n  const { scrollY } = useScroll();\n  const opacity = useTransform(scrollY, [0, 300], [1, 0]);\n  const scale = useTransform(scrollY, [0, 300], [1, 1.05]);\n  const videoRef = useRef<HTMLVideoElement>(null);\n\n  useEffect(() => {\n    if (videoRef.current) {\n      videoRef.current.playbackRate = prefersReducedMotion ? 0 : 0.75;\n      videoRef.current.play().catch(() => {});\n    }\n  }, [prefersReducedMotion]);\n\n  return (\n    <section className=\"relative h-screen w-full overflow-hidden bg-obsidian-950\" aria-label=\"Hero\">\n      {/* Video Background */}\n      <motion.div style={{ opacity, scale }} className=\"absolute inset-0 z-0\">\n        <video\n          ref={videoRef}\n          autoPlay\n          muted\n          loop\n          playsInline\n          poster=\"/hero-poster.jpg\"\n          className=\"h-full w-full object-cover opacity-60\"\n          onCanPlay={() => {}}\n        >\n          <source src=\"/hero-desktop.mp4\" type=\"video/mp4\" />\n        </video>\n        {/* Cinematic Overlays */}\n        <div className=\"absolute inset-0 bg-gradient-to-b from-obsidian-950/40 via-transparent to-obsidian-950/80\" />\n        <div className=\"absolute inset-0 bg-[url('/grain.png')] opacity-10 mix-blend-overlay\" />\n      </motion.div>\n\n      {/* Content */}\n      <div className=\"relative z-10 flex h-full flex-col items-center justify-center px-4 text-center sm:px-6 lg:px-8\">\n        <motion.h1\n          initial={prefersReducedMotion ? {} : { opacity: 0, y: 40 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 0.8, ease: [0.19, 1, 0.22, 1], delay: 0.2 }}\n          className=\"text-hero font-display font-light tracking-tight text-metallic-champagne\"\n        >\n          Digital Haute Couture\n        </motion.h1>\n\n        <motion.p\n          initial={prefersReducedMotion ? {} : { opacity: 0, y: 20 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 0.8, ease: [0.19, 1, 0.22, 1], delay: 0.4 }}\n          className=\"mt-6 max-w-2xl text-lg text-obsidian-100/80\"\n        >\n          Where cinematic storytelling meets intelligent commerce.\n        </motion.p>\n\n        <motion.div\n          initial={prefersReducedMotion ? {} : { opacity: 0, y: 20 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 0.8, ease: [0.19, 1, 0.22, 1], delay: 0.6 }}\n          className=\"mt-10 flex gap-4\"\n        >\n          <MagneticButton strength={0.15} radius={100}>\n            <a href=\"/shop\" className=\"inline-flex h-12 items-center justify-center rounded-lg bg-metallic-champagne px-8 text-sm font-medium text-obsidian-950 transition-colors hover:bg-metallic-gold\">\n              Explore Collection\n            </a>\n          </MagneticButton>\n          <MagneticButton strength={0.15} radius={100}>\n            <a href=\"/editorial\" className=\"inline-flex h-12 items-center justify-center rounded-lg border border-obsidian-100/30 px-8 text-sm font-medium text-obsidian-100 transition-colors hover:bg-obsidian-100/10\">\n              Read Editorial\n            </a>\n          </MagneticButton>\n        </motion.div>\n      </div>\n\n      {/* Scroll Indicator */}\n      <motion.div\n        initial={prefersReducedMotion ? {} : { opacity: 0 }}\n        animate={{ opacity: 1 }}\n        transition={{ delay: 1.2, duration: 0.8 }}\n        className=\"absolute bottom-8 left-1/2 z-10 flex -translate-x-1/2 flex-col items-center gap-2 text-obsidian-100/60\"\n      >\n        <span className=\"text-xs font-medium tracking-widest uppercase\">Scroll to explore</span>\n        <motion.div\n          animate={prefersReducedMotion ? {} : { y: [0, 8, 0] }}\n          transition={{ duration: 1.5, repeat: Infinity, ease: \"easeInOut\" }}\n          className=\"h-6 w-px bg-gradient-to-b from-transparent to-metallic-champagne\"\n        />\n      </motion.div>\n    </section>\n  );\n}\n"],"names":["HeroSection","prefersReducedMotion","scrollY","opacity","scale","videoRef","current","playbackRate","play","catch","className","div","style","ref","autoPlay","muted","loop","playsInline","poster","onCanPlay","src","type","h1","initial","y","animate","transition","duration","ease","delay","p","strength","radius","href","repeat","Infinity"],"mappings":";;;;;AAEA;AACA;AAAA;AAAA;AAAA;AACA;;;AAJA;;;;AAMO,SAASA;;IACd,MAAMC,uBAAuB,IAAA,4WAAgB;IAC7C,MAAM,EAAEC,OAAO,EAAE,GAAG,IAAA,qUAAS;IAC7B,MAAMC,UAAU,IAAA,2UAAY,EAACD,SAAS;QAAC;QAAG;KAAI,EAAE;QAAC;QAAG;KAAE;IACtD,MAAME,QAAQ,IAAA,2UAAY,EAACF,SAAS;QAAC;QAAG;KAAI,EAAE;QAAC;QAAG;KAAK;IACvD,MAAMG,WAAW,IAAA,wUAAM,EAAmB;IAE1C,IAAA,2UAAS;iCAAC;YACR,IAAIA,SAASC,OAAO,EAAE;gBACpBD,SAASC,OAAO,CAACC,YAAY,GAAGN,uBAAuB,IAAI;gBAC3DI,SAASC,OAAO,CAACE,IAAI,GAAGC,KAAK;6CAAC,KAAO;;YACvC;QACF;gCAAG;QAACR;KAAqB;IAEzB,qBACE,8VAAC;QAAQS,WAAU;QAA2D,cAAW;;0BAEvF,8VAAC,mVAAM,CAACC,GAAG;gBAACC,OAAO;oBAAET;oBAASC;gBAAM;gBAAGM,WAAU;;kCAC/C,8VAAC;wBACCG,KAAKR;wBACLS,QAAQ;wBACRC,KAAK;wBACLC,IAAI;wBACJC,WAAW;wBACXC,QAAO;wBACPR,WAAU;wBACVS,WAAW,KAAO;kCAElB,cAAA,8VAAC;4BAAOC,KAAI;4BAAoBC,MAAK;;;;;;;;;;;kCAGvC,8VAAC;wBAAIX,WAAU;;;;;;kCACf,8VAAC;wBAAIA,WAAU;;;;;;;;;;;;0BAIjB,8VAAC;gBAAIA,WAAU;;kCACb,8VAAC,mVAAM,CAACY,EAAE;wBACRC,SAAStB,uBAAuB,CAAC,IAAI;4BAAEE,SAAS;4BAAGqB,GAAG;wBAAG;wBACzDC,SAAS;4BAAEtB,SAAS;4BAAGqB,GAAG;wBAAE;wBAC5BE,YAAY;4BAAEC,UAAU;4BAAKC,MAAM;gCAAC;gCAAM;gCAAG;gCAAM;6BAAE;4BAAEC,OAAO;wBAAI;wBAClEnB,WAAU;kCACX;;;;;;kCAID,8VAAC,mVAAM,CAACoB,CAAC;wBAC